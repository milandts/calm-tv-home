<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="app.calmtv.home.dream">

    <!-- Nur für das Wetter (Open-Meteo). Der Launcher TV Home selbst hat keine Internetberechtigung. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Lesezugriff auf den letzten Wetterstand, nur für Apps mit demselben Schlüssel (TV Home). Die Definition steht in beiden APKs. -->
    <permission
        android:name="app.calmtv.home.permission.READ_WEATHER"
        android:protectionLevel="signature" />
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:allowBackup="false"
        android:usesCleartextTraffic="false"
        android:icon="@drawable/icon"
        android:label="@string/app_name">

        <!-- Der eigentliche Bildschirmschoner (Android "Daydream"). -->
        <service
            android:name=".AmbientDream"
            android:exported="true"
            android:icon="@drawable/icon"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="android.service.dream"
                android:resource="@xml/dream" />
        </service>

        <!-- Optionaler Abruf alle 2 Stunden (Einstellung "Auffrischen"); prüft vor dem Abruf selbst, ob er noch gewünscht ist. -->
        <service
            android:name=".WeatherRefresh$Job"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- Gibt den Wetterstand nur lesend an TV Home weiter (Temperatur und Text, kein Ort). -->
        <provider
            android:name=".WeatherProvider"
            android:authorities="app.calmtv.home.dream.weather"
            android:exported="true"
            android:readPermission="app.calmtv.home.permission.READ_WEATHER" />

        <!-- Zeigt denselben Bildschirmschoner sofort (Kachel in TV Home); jede Taste beendet ihn. -->
        <activity
            android:name=".PreviewActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:screenOrientation="landscape"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen" />

        <!-- Stadt für das Wetter wählen. -->
        <activity
            android:name=".SetupActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:screenOrientation="landscape"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar" />
    </application>
</manifest>
